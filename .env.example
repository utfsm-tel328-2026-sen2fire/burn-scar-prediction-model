# Configuración local de almacenamiento compartido y tracking de experimentos.
# Copia este archivo a `.env` y ajusta los valores a tu máquina:
#   cp .env.example .env

# Ruta local donde está montado el directorio compartido por NFS (TK_Stratego/Shared).
# Ejemplo para colaborador:
#   BURNSCAR_SHARED_STORAGE=/home/companero/ruta/TK_Stratego/Shared
# Si se deja vacío o la ruta no está disponible, se usará fallback local (./runs y ./checkpoints).

# Identificador del investigador para aislar subcarpetas de experimentos y checkpoints
# (ej: antonio, companero)
#BURNSCAR_USER=user

# Puerto por defecto para levantar el servidor de TensorBoard
BURNSCAR_TENSORBOARD_PORT=6006
